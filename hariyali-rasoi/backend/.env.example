# Local Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hariyali_rasoi
# Supabase Session Pooler (IPv4-friendly; Connect → Session mode):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hariyali_rasoi
SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_EMAIL=admin@hariyalirasoi.com
ADMIN_PASSWORD=$2b$12$...bcrypt-hash-here...
# Render: prefer ADMIN_PASSWORD_B64 ($ in bcrypt often breaks in dashboard env)
# python scripts/hash_password.py YourPassword
# python scripts/encode_password_b64.py '$2b$12$...'
# ADMIN_PASSWORD_B64=base64-of-bcrypt-hash

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

ENVIRONMENT=development
# Render: ENVIRONMENT=production (disables /docs)
WHATSAPP_NUMBER=919XXXXXXXXX
APP_URL=http://localhost:8000
# Render: APP_URL=https://hariyali-rasoi-api.onrender.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,https://hariyalirasoi.com,https://www.hariyalirasoi.com
# Also add your Render frontend URL, e.g. https://hariyali-rasoi-web.onrender.com
